
# Default SCK header
snippet head
        ------------------------------------------------------------------------------------------
        --! @file `vim_snippets#Filename()`.vhd
        ------------------------------------------------------------------------------------------
        --! @copyright Copyright `system("printf '%(%Y)T'")` SCK-CEN
        ------------------------------------------------------------------------------------------
        --! @date `system("printf '%(%d/%m/%Y)T'")`
        ------------------------------------------------------------------------------------------
        --! @brief ${1}
        ------------------------------------------------------------------------------------------
        
        --! Use standard libs
        library ieee;
        use ieee.std_logic_1164.all;
        use ieee.numeric_std.all;
        
        --!
        library desy;
        use desy.common_types.all;
        


# Entity template
snippet src

        ------------------------------------------------------------------------------------------
        --! @file `vim_snippets#Filename()`.vhd
        ------------------------------------------------------------------------------------------
        --! @copyright Copyright `system("printf '%(%Y)T'")` SCK-CEN
        ------------------------------------------------------------------------------------------
        --! @date `system("printf '%(%d/%m/%Y)T'")`
        ------------------------------------------------------------------------------------------
        --! @brief Module ${1:`vim_snippets#Filename()`} is ${2}
        ------------------------------------------------------------------------------------------
        
        --! Use standard libs
        library ieee;
        use ieee.std_logic_1164.all;
        use ieee.numeric_std.all;
        
        --! Add the desy library
        library desy;
        use desy.common_types.all;
        
        --! @brief This is the description of entity $1
        entity $1 is
          generic(
            ${3:}
          );
          port(
            --! Clock and reset inputs.
            pi_clock         : in std_logic;
            pi_reset         : in std_logic;
            --! Entity ports
            ${4}
          );
        end entity $1;
        
        --! @brief Architecture of $1 
        architecture behavioral of $1 is
        -- Signals and constant declaration
        begin
          -- Sequential logic
          prs_$1 : process(pi_clock)
          begin
            if rising_edge(pi_clock) then
              if pi_reset = '1' then
                -- Reset logic
                ${5}
              else
                -- Sequential statements
                ${6}
              end if;
            end if;
          end process prs_$1;
        
          -- Combinatorial logic
        end architecture behavioral;


# Package template
snippet pkg
        ------------------------------------------------------------------------------------------
        --! @file `vim_snippets#Filename()`.vhd
        ------------------------------------------------------------------------------------------
        --! @copyright Copyright `system("printf '%(%Y)T'")` SCK-CEN
        ------------------------------------------------------------------------------------------
        --! @date `system("printf '%(%d/%m/%Y)T'")`
        ------------------------------------------------------------------------------------------
        --! @brief Package ${1:`vim_snippets#Filename()`} is ${2}
        ------------------------------------------------------------------------------------------
        
        --! Use standard libs
        library ieee;
        use ieee.std_logic_1164.all;
        use ieee.numeric_std.all;
        
        --!
        library desy;
        use desy.common_types.all;
       
        --! Package file for this and that
        package $1 is
          --! Package definitions here
          ${3}
        end package $1;
        
        package body $1 is
          --! Package implementation here
          ${4}
        end package body $1;


# Process with clock
snippet process_noreset
        prs_${1} : process (${2:pi_clock})
        begin
          if rising_edge ($2) then
            -- ! Combinatorial statements
            ${3}
          end if;
        end process prs_$1;


# Process with clock and reset
snippet process
        prs_${1} : process (${2:pi_clock})
        begin
          if (${3:pi_reset} = '${4:1}') then
            --! Reset logic here
          elsif rising_edge($1) then
            --! Combinatorial statements
            ${4}
          end if;
        end process prs_$1;


# Constant
snippet constant
        constant C_${1} : ${2} := ${3};


# Variable
snippet variable
        variable v_${1} : ${2} := ${3};


# Signal
snippet signal
        signal ${1} : ${2} := ${3};


# Loop
snippet for_loop
        lp_${1} : for ${2:i} in ${3} to ${4} loop
          ${5}
        end loop lp_$1;


# While
snippet while_loop
        lp_${1} : while ${2} loop
          ${3}
        end loop lp_$1;


# Generate if
snippet if_generate
        gen_${1} : if ${2} generate
          ${3}
        ${4:else generate}
          ${5}
        end generate gen_$1; 

# Generate for
snippet generate_for
        gen_${1} : for ${2:i} in ${3} to ${4} generate
          ${5}
        end generate gen_$1; 

# Block
snippet block
         blk_${1} : block 
           ${2}
         begin
           ${3}
         end block blk_$1;

# Entity
snippet entity
        entity ${1} is
          generic(
            ${2:}
          );
          port(
            pi_clock         : in std_logic;
            pi_reset         : in std_logic;
            ${3}
          );
        end entity $1;
        
        architecture behavioral of $1 is
        begin
          prs_$1 : process(pi_clock)
          begin
            if rising_edge(pi_clock) then
              if pi_reset = '1' then
                ${4}
              else
                ${5}
              end if;
            end if;
          end process prs_$1;
        end architecture behavioral;


# Package
snippet package
        package ${1} is
          ${3}
        end package $1;
        
        package body $1 is
          ${4}
        end package body $1;


# Type
snippet type
        type t_${1} is ${2};

# Range
snippet range
        range ${1} to ${2}


# Range unconstrained
snippet range_unconstrained
        range <> 


# Array
snippet array
        array (range ${1} to ${2}) of ${3}


# Array unconstrained
snippet array_unconstrained
        array (range <>) of ${1}


# Function
snippet function
        ${1:pure} function f_${2}(${3:}) is
          ${4}
        begin
          ${5}
        end function;

# Procedure 
snippet procedure 
        procedure prd_${1}(${2:}) is
          ${3}
        begin
          ${4}
        end procedure;


# Instance
snippet instance
        ins_${1} : entity ${2}
        generic map (${4})
        port map (${3});


