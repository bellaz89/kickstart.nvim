        ------------------------------------------------------------------------------------------
        --! @date `system("printf '%(%d/%m/%Y)T'")`
        --! @author Andrea Bellandi <andrea.bellandi@sckcen.be>
        ------------------------------------------------------------------------------------------
        --! @brief Package ${1:`vim_snippets#Filename()`} is ${2}
        ------------------------------------------------------------------------------------------
        
        --! Use standard libs
        library ieee;
        use ieee.std_logic_1164.all;
        use ieee.numeric_std.all;
        
        --!
        library desy;
        use desy.common_types.all;
        
        --! Package file for this and that
        package $1 is
          --! Package definitions here
          ${3}
        end package $1;
        
        package body $1 is
          --! Package implementation here
        end package body;


# Process with clock
snippet process_noreset
        prs_${1} : process (${2:pi_clock})
        begin
          if rising_edge ($2) then
            -- ! Combinatorial statements
            ${3}
          end if;
        end process;



# Process with clock and reset
snippet process
        prs_${1} : process (${2:pi_clock})
        begin
          if (${3:pi_reset} = '${4:1}') then
            --! Reset logic here
          elsif rising_edge($1) then
            --! Combinatorial statements
            ${4}
          end if;
        end process;


